# ===== 数据库 (PostgreSQL / Neon) =====
# 核心配置：应用的所有数据（新闻、AI 分析、主题、运行日志）都存这里
DATABASE_URL=postgresql://user:password@host:5432/news_monitor

# ===== AI 配置 (OpenAI 兼容协议) =====
AI_API_KEY=sk-xxx
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash

# 推理模型思考模式开关：默认关闭（不传该变量即为关闭）。
# 原因：DeepSeek 等推理模型的思考模式默认开启，思维链与正文**共享** maxOutputTokens
# 预算。实测上限 8192 时 7572 被思考占用、正文仅剩 619，JSON 被截断并抛
# NoOutputGeneratedError，整批失败。本项目的摘要/聚类不需要思维链。
# 若切换到不认识 thinking 参数的 provider，设为 enabled 停发该参数。
# AI_THINKING=enabled

# 输出 token 上限，默认 384000（DeepSeek 上限 384K）。
# 注意：部分 provider 按 max_tokens 预留额度/校验模型上限，此时需调小。
# AI_MAX_OUTPUT_TOKENS=384000

# ===== 数据源 =====
# Product Hunt API Token
PRODUCTHUNT_TOKEN=xxx
# X / Twitter 网页版认证（cookie 中的 auth_token 与 ct0）
TWITTER_AUTH_TOKEN=xxx
TWITTER_CT0=xxx

# ===== 日志（可选）=====
# debug | info | warn | error，默认 info
LOG_LEVEL=info

# ===== Sentry (可选：监控运行时错误) =====
# 留空 = Sentry 关闭（SDK 自动 noop）
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# 仅在 source map 自动上传时需要
SENTRY_ORG=your-org
SENTRY_PROJECT=news-monitor
# SENTRY_AUTH_TOKEN=sntrys_xxx
# ===== 管理员鉴权（读公开/写受控）=====
# 写操作（标记已读/重置）与运维仪表盘需要此 token
# 生成方式: openssl rand -hex 24
# 前端通过「管理员登录」输入，存 localStorage；请求时经 x-admin-token header 传递
#
# 注意：本仓库是**公开仓库**，真实 token 值绝不写入任何被追踪的文件。
# 运行时由 Vercel / GitHub Actions 平台环境变量提供；本地放 .env.local（已 gitignore）。
# 防暴力破解：middleware.ts 对失败尝试做滑动窗口限流，详见 docs/ops/admin-auth.md
ADMIN_TOKEN=xxx
