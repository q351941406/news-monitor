# Upstash Redis (去重 + 数据存储)
UPSTASH_REDIS_URL=https://xxx.upstash.io
UPSTASH_REDIS_TOKEN=AXxx

# AI 配置 (DeepSeek / Anthropic 兼容)
ANTHROPIC_API_KEY=sk-xxx
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-flash

# Telegram
TELEGRAM_BOT_TOKEN=xxx
TELEGRAM_GROUP_ID=-100xxx
TELEGRAM_GITHUB_TOPIC_ID=206
TELEGRAM_PH_TOPIC_ID=12
TELEGRAM_X_TOPIC_ID=13

# Discord Webhooks
DISCORD_GITHUB_WEBHOOK=https://discordapp.com/api/webhooks/xxx
DISCORD_PH_WEBHOOK=https://discordapp.com/api/webhooks/xxx
DISCORD_X_WEBHOOK=https://discordapp.com/api/webhooks/xxx

# Product Hunt
PRODUCTHUNT_TOKEN=xxx

# GitHub Actions 调用密钥 (校验 webhook 来源)
CRON_SECRET=your-random-secret

# ===== Sentry (可选：监控运行时错误) =====
# 留空 = Sentry 关闭（SDK 自动 noop）
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# 仅在 source map 自动上传时需要
SENTRY_ORG=your-org
SENTRY_PROJECT=news-monitor
# SENTRY_AUTH_TOKEN=sntrys_xxx
