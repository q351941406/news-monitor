{
  "name": "news-monitor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mjs",
    "test:watch": "vitest --config vitest.config.mjs",
    "test:integration": "vitest run --config vitest.config.integration.mjs",
    "test:all": "npm test && npm run test:integration",
    "test:coverage": "vitest run --config vitest.config.mjs --coverage",
    "test:coverage:check": "vitest run --config vitest.config.mjs --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:migrate:ci": "npx tsx scripts/migrate-ci.ts",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:status": "drizzle-kit status",
    "db:drop": "drizzle-kit drop",
    "scrape": "npx tsx scripts/scrape.ts",
    "ai-process": "npx tsx scripts/ai-process.ts",
    "topic-aggregate": "npx tsx scripts/topic-aggregate.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.7",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/nextjs": "^10.69.0",
    "ai": "^7.0.13",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.23.0",
    "next": "^15.1.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "postcss": "^8.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
