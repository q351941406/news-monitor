    "eslint-config-next": "^15.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "postcss": "^8.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
