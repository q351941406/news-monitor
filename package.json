    "ai": "^7.0.13",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.23.0",
    "next": "^15.1.0",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
